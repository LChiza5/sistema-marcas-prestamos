# Variables usadas por docker-compose.yml
# Copiar este archivo como .env antes de levantar los contenedores.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=marcas_prestamos
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

# Puerto en el que MySQL queda expuesto en la máquina local
MYSQL_PORT=3307

# Puerto de phpMyAdmin
PHPMYADMIN_PORT=8080
